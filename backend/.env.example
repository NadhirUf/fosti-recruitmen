PORT=4000
CORS_ORIGIN=http://localhost:5173

# Token rahasia buat akses /api/admin/*  (bebas, contoh: hasil `openssl rand -hex 16`)
# WAJIB diisi kalau mau pakai halaman admin. Kalau kosong, endpoint admin terkunci total.
ADMIN_TOKEN=

# --- Email lewat Gmail (akun khusus, bukan email pribadi/kampus) ---
# GMAIL_APP_PASSWORD didapat dari myaccount.google.com/security > App passwords
# (bukan password akun Gmail biasa).
GMAIL_USER=fostiums.oprec@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=OprecFosti

# --- Email fallback via Resend (dipakai HANYA kalau GMAIL_* di atas kosong) ---
RESEND_API_KEY=
RESEND_FROM=FOSTI UMS <onboarding@resend.dev>

# --- Tombol "Konfirmasi ke Contact Person" di email (link wa.me) ---
# Nomor WA format internasional, TANPA "+" atau "0" di depan.
# Contoh: nomor 0858-6920-6330 -> 6285869206330
CP1_NAME=Daffa
CP1_WHATSAPP=
CP2_NAME=Fadella
CP2_WHATSAPP=

# WhatsApp notifikasi OTOMATIS dari sistem via Fonnte (https://fonnte.com) - opsional
FONNTE_TOKEN=
